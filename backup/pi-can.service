[Unit]
Description=Bring up CAN interfaces for BMSanta
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "/sbin/ip link set can0 up type can bitrate 250000 restart-ms 100 2>/dev/null || true; /sbin/ip link set can1 up type can bitrate 250000 restart-ms 100 2>/dev/null || true"
ExecStop=/bin/sh -c "/sbin/ip link set can0 down 2>/dev/null || true; /sbin/ip link set can1 down 2>/dev/null || true"

[Install]
WantedBy=multi-user.target
