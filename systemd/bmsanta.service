[Unit]
Description=BMSanta Battery Management & Inverter Gateway Daemon
After=network.target can.service
Wants=can.service

[Service]
Type=simple
User=dangersorus
WorkingDirectory=/home/dangersorus/bmsanta
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m daemon.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
